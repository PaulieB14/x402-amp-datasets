# Local ampd — the JSONL SQL endpoint exposed by `ampd solo --jsonl-server`.
AMP_ORIGIN=http://localhost:1603

# ampd in solo mode doesn't actually require auth, but the env validator
# wants at least 16 chars. Pick anything.
AMP_TOKEN=local-dev-token-not-checked

# The Base mainnet dataset registered in your ampd. Confirm with
# `curl http://localhost:1610/datasets`.
AMP_DATASET=_/base_mainnet@2.0.0

# Hard cap on any single ampd query. 15s leaves slack for cold-cache scans
# over the small-parquet backlog; tighten to 8s once the compactor catches up.
AMP_QUERY_TIMEOUT_MS=15000
